generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  role                Role
  status              UserStatus
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  doctorProfile       DoctorProfile?
  passwordResetTokens PasswordResetToken[]
  passwordSetupTokens PasswordSetupToken[]
  patientProfile      PatientProfile?
}

model PatientProfile {
  id                String             @id
  firstName         String
  lastName          String
  phone             String
  dob               DateTime?
  gender            Gender?
  bloodGroup        String?
  patientId         String             @unique
  avatarUrl         String?
  appointments      Appointment[]
  consultations     Consultation[]
  emergencyContacts EmergencyContact[]
  user              User               @relation(fields: [id], references: [id])
}

model DoctorProfile {
  id               String           @id
  firstName        String
  lastName         String
  licenseNumber    String
  consultationFee  Float
  rating           Float            @default(0)
  phone            String?
  bio              String?
  specializationId String
  avatarUrl        String?
  appointments     Appointment[]
  consultations    Consultation[]
  user             User             @relation(fields: [id], references: [id])
  specialization   Specialization   @relation(fields: [specializationId], references: [id])
  schedules        DoctorSchedule[]
  slots            Slot[]
  leaves           DoctorLeave[]

  @@index([specializationId])
}

model Slot {
  id               String           @id @default(uuid())
  doctorId         String
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  capacity         Int
  bookedCount      Int              @default(0)
  consultationType ConsultationType
  doctor           DoctorProfile    @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([date])
}

model DoctorSchedule {
  id                  String        @id @default(uuid())
  doctorId            String
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int           @default(60)
  fullDay             Boolean       @default(false)
  slotCapacity        Int           @default(5)
  consultationType    ConsultationType @default(CLINIC)
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  status          AppointmentStatus
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now())
  slotEnd         String
  slotStart       String
  doctor          DoctorProfile     @relation(fields: [doctorId], references: [id])
  patient         PatientProfile    @relation(fields: [patientId], references: [id])
  consultation    Consultation?
}



model EmergencyContact {
  id        String         @id @default(uuid())
  name      String
  mobile    String
  patientId String
  createdAt DateTime       @default(now())
  patient   PatientProfile @relation(fields: [patientId], references: [id])
}

model PasswordSetupToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Specialization {
  id        String          @id @default(uuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  doctors   DoctorProfile[]
}

model Consultation {
  id            String             @id @default(uuid())
  appointmentId String             @unique
  doctorId      String
  patientId     String
  status        ConsultationStatus @default(WAITING)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  appointment   Appointment        @relation(fields: [appointmentId], references: [id])
  doctor        DoctorProfile      @relation(fields: [doctorId], references: [id])
  patient       PatientProfile     @relation(fields: [patientId], references: [id])
  medicalRecord MedicalRecord?
  prescription  Prescription?
  vitals        Vitals[]
}

model MedicalRecord {
  id             String       @id @default(uuid())
  consultationId String       @unique
  symptoms       String
  diagnosis      String
  notes          String?
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Vitals {
  id             String       @id @default(uuid())
  consultationId String
  bloodPressure  String?
  heartRate      Int?
  temperature    Float?
  weight         Float?
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String       @unique
  instructions   String?
  medicines      Medicine[]
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Medicine {
  id             String       @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String
  frequency      String
  duration       String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NOT_ATTENDED
}

enum ConsultationStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum ConsultationType {
  VIDEO
  CLINIC
}

model DoctorLeave {
  id        String      @id @default(uuid())
  doctorId  String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}
