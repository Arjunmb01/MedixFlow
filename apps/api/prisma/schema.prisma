generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  role                Role
  status              UserStatus
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  doctorProfile       DoctorProfile?
  passwordResetTokens PasswordResetToken[]
  passwordSetupTokens PasswordSetupToken[]
  patientProfile      PatientProfile?

  @@index([role, status])
  @@index([deletedAt])
}

model PatientProfile {
  id                String             @id
  firstName         String
  lastName          String
  phone             String
  dob               DateTime?
  gender            Gender?
  bloodGroup        String?
  patientId         String             @unique
  avatarUrl         String?
  appointments      Appointment[]
  consultations     Consultation[]
  emergencyContacts EmergencyContact[]
  followUps         FollowUp[]
  user              User               @relation(fields: [id], references: [id])
  payments          Payment[]
  wallet            Wallet?

  @@index([firstName, lastName])
}

model DoctorProfile {
  id               String           @id
  firstName        String
  lastName         String
  licenseNumber    String
  consultationFee  Float
  rating           Float            @default(0)
  phone            String?
  bio              String?
  specializationId String
  avatarUrl        String?
  experienceYears  Int              @default(0)
  languages        String[]         @default(["English"])
  appointments     Appointment[]
  consultations    Consultation[]
  breaks           DoctorBreak[]
  leaves           DoctorLeave[]
  user             User             @relation(fields: [id], references: [id])
  specialization   Specialization   @relation(fields: [specializationId], references: [id])
  schedules        DoctorSchedule[]
  followUps        FollowUp[]
  slots            Slot[]

  @@index([specializationId])
  @@index([firstName, lastName])
  @@index([experienceYears])
  @@index([consultationFee])
  @@index([rating])
}

model Slot {
  id               String           @id @default(uuid())
  doctorId         String
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  capacity         Int
  bookedCount      Int              @default(0)
  consultationType ConsultationType
  doctor           DoctorProfile    @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([date])
}

model DoctorSchedule {
  id                  String           @id @default(uuid())
  doctorId            String
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int              @default(60)
  slotCapacity        Int              @default(5)
  fullDay             Boolean          @default(false)
  consultationType    ConsultationType @default(CLINIC)
  bufferTimeMinutes   Int              @default(0)
  doctor              DoctorProfile    @relation(fields: [doctorId], references: [id])
}

model DoctorBreak {
  id        String        @id @default(uuid())
  doctorId  String
  name      String        @default("Break")
  startTime String
  endTime   String
  dayOfWeek Int
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
}

