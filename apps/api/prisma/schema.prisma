generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  role                Role
  status              UserStatus
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  doctorProfile       DoctorProfile?
  passwordResetTokens PasswordResetToken[]
  passwordSetupTokens PasswordSetupToken[]
  patientProfile      PatientProfile?

  @@index([role, status])
  @@index([deletedAt])
}

model PatientProfile {
  id                String             @id
  firstName         String
  lastName         String
  phone             String
  dob               DateTime?
  gender            Gender?
  bloodGroup        String?
  patientId         String             @unique
  avatarUrl         String?
  appointments      Appointment[]
  consultations     Consultation[]
  emergencyContacts EmergencyContact[]
  payments          Payment[]
  wallet            Wallet?
  user              User               @relation(fields: [id], references: [id])

  @@index([firstName, lastName])
}

model DoctorProfile {
  id               String           @id
  firstName        String
  lastName         String
  licenseNumber    String
  consultationFee  Float
  rating           Float            @default(0)
  phone            String?
  bio              String?
  specializationId String
  experienceYears Int              @default(0)
  languages       String[]         @default(["English"])
  avatarUrl        String?
  appointments     Appointment[]
  consultations    Consultation[]
  user             User             @relation(fields: [id], references: [id])
  specialization   Specialization   @relation(fields: [specializationId], references: [id])
  schedules        DoctorSchedule[]
  slots            Slot[]
  leaves           DoctorLeave[]
  breaks           DoctorBreak[]

  @@index([specializationId])
  @@index([firstName, lastName])
  @@index([experienceYears])
  @@index([consultationFee])
  @@index([rating])
}

model Slot {
  id               String           @id @default(uuid())
  doctorId         String
  date             DateTime
  startTime        DateTime
  endTime          DateTime
  capacity         Int
  bookedCount      Int              @default(0)
  consultationType ConsultationType
  doctor           DoctorProfile    @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([date])
}

model DoctorSchedule {
  id                  String        @id @default(uuid())
  doctorId            String
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int           @default(60)
  fullDay             Boolean       @default(false)
  slotCapacity        Int           @default(5)
  bufferTimeMinutes   Int           @default(0)
  consultationType    ConsultationType @default(CLINIC)
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id])
}

model DoctorBreak {
  id        String        @id @default(uuid())
  doctorId  String
  name      String        @default("Break")
  startTime String        // e.g. "13:00"
  endTime   String        // e.g. "14:00"
  dayOfWeek Int           // 0-6
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
}

model Appointment {
  id              String            @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate DateTime
  status          AppointmentStatus
  reason          String?
  notes           String?
  createdAt       DateTime          @default(now())
  slotEnd         String
  slotStart       String
  startTime       DateTime?
  endTime         DateTime?
  paymentStatus   PaymentStatus?    @default(PENDING)
  paymentMethod   PaymentMethod?    @default(RAZORPAY)
  queueNumber     Int?
  expiresAt       DateTime?         // For pending reservation timeout
  doctor          DoctorProfile     @relation(fields: [doctorId], references: [id])
  patient         PatientProfile    @relation(fields: [patientId], references: [id])
  consultation    Consultation?
  payment         Payment?
  
  // Reschedule & History
  rescheduledToId   String?       @unique
  rescheduledTo     Appointment?  @relation("RescheduleHistory", fields: [rescheduledToId], references: [id])
  rescheduledFrom   Appointment?  @relation("RescheduleHistory")
  
  auditLogs         AppointmentAuditLog[]
  proposals         RescheduleProposal[]

  lastStatusChangedAt DateTime    @default(now())
  parentAppointmentId String?

  @@index([doctorId, appointmentDate, status])
  @@index([patientId, status])
  @@index([doctorId, startTime, endTime])
  @@index([expiresAt])
}

model AppointmentAuditLog {
  id            String   @id @default(uuid())
  appointmentId String
  action        String   // BOOKED, RESCHEDULED, CANCELLED, STATUS_CHANGE, REASSIGNED
  actorId       String   // userId
  actorRole     Role
  oldStatus     AppointmentStatus?
  newStatus     AppointmentStatus?
  details       Json?    // Store what changed (date, slot, etc.)
  createdAt     DateTime @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([actorId])
}

model RescheduleProposal {
  id              String            @id @default(uuid())
  appointmentId   String
  proposedById    String            // User.id
  proposedByRole  Role
  newDate         DateTime
  newSlotStart    String
  newSlotEnd      String
  status          ProposalStatus    @default(PENDING)
  reason          String?
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  appointment     Appointment       @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@index([status])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}



model EmergencyContact {
  id        String         @id @default(uuid())
  name      String
  mobile    String
  patientId String
  createdAt DateTime       @default(now())
  patient   PatientProfile @relation(fields: [patientId], references: [id])
}

model PasswordSetupToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Specialization {
  id        String          @id @default(uuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  doctors   DoctorProfile[]
}

model Consultation {
  id            String             @id @default(uuid())
  appointmentId String             @unique
  doctorId      String
  patientId     String
  status        ConsultationStatus @default(WAITING)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  appointment   Appointment        @relation(fields: [appointmentId], references: [id])
  doctor        DoctorProfile      @relation(fields: [doctorId], references: [id])
  patient       PatientProfile     @relation(fields: [patientId], references: [id])
  medicalRecord MedicalRecord?
  prescription  Prescription?
  vitals        Vitals[]
  labTests      LabTest[]
}

model MedicalRecord {
  id                String       @id @default(uuid())
  consultationId    String       @unique
  symptoms          String
  diagnosis         String
  notes             String?
  planForManagement String?      // New field for precautions
  consultation      Consultation @relation(fields: [consultationId], references: [id])
}

model Vitals {
  id             String       @id @default(uuid())
  consultationId String
  bloodPressure  String?
  heartRate      Int?
  temperature    Float?
  weight         Float?
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String       @unique
  instructions   String?
  medicines      Medicine[]
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Medicine {
  id             String       @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String
  frequency      String
  duration       String
  instructions   String?      // New field for "When to eat" etc.
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

model LabTest {
  id             String       @id @default(uuid())
  consultationId String
  testName       String
  status         LabTestStatus @default(PENDING)
  reportUrl      String?      // URL to the uploaded file
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

enum LabTestStatus {
  PENDING
  UPLOADED
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
  PENDING
  PAYMENT_FAILED_HOLD
  EXPIRED
  RESCHEDULED
  REASSIGNED
}

enum ConsultationStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum ConsultationType {
  VIDEO
  CLINIC
}

model DoctorLeave {
  id        String      @id @default(uuid())
  doctorId  String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  type      LeaveType   @default(LEAVE)
  isProcessed Boolean   @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
}

enum LeaveType {
  LEAVE
  EMERGENCY
  PERSONAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String           // User.id
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

enum NotificationType {
  BOOKED
  CANCELLED
  COMPLETED
  PRESCRIPTION
  RESCHEDULED
  LAB_TEST
  RESCHEDULE_REQUEST
  RESCHEDULE_PROPOSAL
  DOCTOR_UNAVAILABLE
  REASSIGNED
}

model Payment {
  id                    String         @id @default(uuid())
  appointmentId         String         @unique
  patientId             String
  amount                Float
  currency              String         @default("inr")
  
  // Gateway specific IDs
  razorpayOrderId       String?        @unique
  razorpayPaymentId     String?
  razorpaySignature     String?
  
  stripeSessionId       String?        @unique
  stripePaymentIntentId String?        @unique
  
  paypalOrderId         String?        @unique
  paypalCaptureId       String?        @unique

  walletAmount          Float          @default(0)

  paymentMethod         PaymentMethod  @default(RAZORPAY)
  status                PaymentStatus  @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  appointment           Appointment    @relation(fields: [appointmentId], references: [id])
  patient               PatientProfile @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([stripeSessionId])
  @@index([paypalOrderId])
}

enum PaymentMethod {
  RAZORPAY
  WALLET
  STRIPE
  PAYPAL
}

model Wallet {
  id        String              @id @default(uuid())
  patientId String              @unique
  balance   Float               @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  patient   PatientProfile      @relation(fields: [patientId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String      @id @default(uuid())
  walletId  String
  amount    Float
  type      TransactionType
  status    TransactionStatus @default(COMPLETED)
  reason    String?
  stripeSessionId String?
  metadata  Json?
  createdAt DateTime    @default(now())
  wallet    Wallet      @relation(fields: [walletId], references: [id])
}

enum TransactionType {
  TOP_UP
  PAYMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
