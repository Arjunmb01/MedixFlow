model ConsultationSession {
  id             String                    @id @default(uuid())
  roomId         String                    @unique
  appointmentId  String                    @unique
  consultationId String?                   @unique
  doctorId       String
  patientId      String
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?
  status         ConsultationSessionStatus @default(WAITING)
  summary        String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  appointment    Appointment               @relation(fields: [appointmentId], references: [id])
  consultation   Consultation?             @relation(fields: [consultationId], references: [id])
  participants   ConsultationParticipant[]
  chatMessages   ConsultationChatMessage[]

  @@index([doctorId, status])
  @@index([patientId, status])
}

model ConsultationParticipant {
  id        String          @id @default(uuid())
  sessionId String
  userId    String
  role      ParticipantRole
  joinedAt  DateTime?
  leftAt    DateTime?
  socketId  String?
  session   ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model ConsultationChatMessage {
  id         String          @id @default(uuid())
  sessionId  String
  senderId   String
  senderRole ParticipantRole
  message    String
  createdAt  DateTime        @default(now())
  session    ConsultationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

enum ConsultationSessionStatus {
  WAITING
  IN_CALL
  ENDED
  CANCELLED
}

enum ParticipantRole {
  DOCTOR
  PATIENT
}

model MedicalRecord {
  id                String       @id @default(uuid())
  consultationId    String       @unique
  symptoms          String
  diagnosis         String
  notes             String?
  planForManagement String?
  consultation      Consultation @relation(fields: [consultationId], references: [id])
}

model Vitals {
  id             String       @id @default(uuid())
  consultationId String
  bloodPressure  String?
  heartRate      Int?
  temperature    Float?
  weight         Float?
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Prescription {
  id             String       @id @default(uuid())
  consultationId String       @unique
  instructions   String?
  medicines      Medicine[]
  consultation   Consultation @relation(fields: [consultationId], references: [id])
}

model Medicine {
  id             String       @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  afternoon      Boolean      @default(false)
  foodTiming     FoodTiming   @default(AFTER_FOOD)
  genericName    String?
  morning        Boolean      @default(false)
  night          Boolean      @default(false)
  type           MedicineType @default(BRAND)
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
}

model LabTest {
  id               String         @id @default(uuid())
  consultationId   String
  testName         String
  status           LabTestStatus  @default(PENDING)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  instructions     String?
  testType         String?
  urgency          LabTestUrgency @default(NORMAL)
  assignedBy       String?
  fastingRequired  Boolean        @default(false)
  isAbnormal       Boolean        @default(false)
  reviewedBy       String?
  reviewerComments String?
  reports          LabReport[]
  consultation     Consultation   @relation(fields: [consultationId], references: [id])
}

model LabReport {
  id         String   @id @default(uuid())
  labTestId  String
  fileUrl    String
  fileName   String
  fileType   String?
  uploadedAt DateTime @default(now())
  labTest    LabTest  @relation(fields: [labTestId], references: [id])
}

model DoctorLeave {
  id          String        @id @default(uuid())
  doctorId    String
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      LeaveStatus   @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  isProcessed Boolean       @default(false)
  type        LeaveType     @default(LEAVE)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  title       String
  message     String
  type        NotificationType
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  metadata    Json?
}

model Payment {
  id                    String         @id @default(uuid())
  appointmentId         String         @unique
  patientId             String
  amount                Float
  currency              String         @default("inr")
  status                PaymentStatus  @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  paymentMethod         PaymentMethod  @default(RAZORPAY)
  razorpayOrderId       String?        @unique
  razorpayPaymentId     String?
  razorpaySignature     String?
  paypalCaptureId       String?        @unique
  paypalOrderId         String?        @unique
  stripePaymentIntentId String?        @unique
  stripeSessionId       String?        @unique
  walletAmount          Float          @default(0)
  appointment           Appointment    @relation(fields: [appointmentId], references: [id])
  patient               PatientProfile @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([stripeSessionId])
  @@index([paypalOrderId])
}

model Wallet {
  id           String              @id @default(uuid())
  patientId    String              @unique
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  patient      PatientProfile      @relation(fields: [patientId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id              String            @id @default(uuid())
  walletId        String
  amount          Float
  type            TransactionType
  status          TransactionStatus @default(COMPLETED)
  reason          String?
  createdAt       DateTime          @default(now())
  metadata        Json?
  stripeSessionId String?
  wallet          Wallet            @relation(fields: [walletId], references: [id])
}

model FollowUp {
  id             String         @id @default(uuid())
  consultationId String         @unique
  patientId      String
  doctorId       String
  scheduledDate  DateTime
  time           String
  type           FollowUpType   @default(PHYSICAL)
  status         FollowUpStatus @default(SCHEDULED)
  reason         String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  consultation   Consultation   @relation(fields: [consultationId], references: [id])
  doctor         DoctorProfile  @relation(fields: [doctorId], references: [id])
  patient        PatientProfile @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledDate])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum FoodTiming {
  BEFORE_FOOD
  AFTER_FOOD
  WITH_FOOD
  EMPTY_STOMACH
}

enum MedicineType {
  BRAND
  GENERIC
}

enum LabTestStatus {
  PENDING
  UPLOADED
  REVIEWED
}

enum LabTestUrgency {
  NORMAL
  URGENT
  EMERGENCY
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
  PENDING
  PAYMENT_FAILED_HOLD
  EXPIRED
  RESCHEDULED
  REASSIGNED
}

enum ConsultationStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum ConsultationType {
  VIDEO
  CLINIC
}

enum LeaveType {
  LEAVE
  EMERGENCY
  PERSONAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

