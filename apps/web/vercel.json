{
  "installCommand": "cd ../.. && npm ci && npm install --no-save -w @medixflow/web @tailwindcss/oxide-linux-x64-gnu@4.2.4 lightningcss-linux-x64-gnu@1.32.0 @rollup/rollup-linux-x64-gnu@4.60.3",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "unsafe-none"
        }
      ]
    }
  ]
}
